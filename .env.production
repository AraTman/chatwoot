# Chatwoot Production Environment Variables
# Copy this file to .env in Coolify and fill in the values

# REQUIRED: Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# REQUIRED: Your domain URL
FRONTEND_URL=https://your-domain.com

# Database Configuration (DO NOT CHANGE - uses Docker service names)
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DATABASE=chatwoot

# Redis Configuration (DO NOT CHANGE - uses Docker service names)
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=your_secure_redis_password_here

# Rails Environment
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_MAX_THREADS=5

# Security
FORCE_SSL=true

# Account Signup
ENABLE_ACCOUNT_SIGNUP=true

# Email Configuration (Optional but recommended)
MAILER_SENDER_EMAIL=support@your-domain.com
SMTP_ADDRESS=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_DOMAIN=your-domain.com
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_AUTHENTICATION=plain

# Active Storage (for file uploads)
ACTIVE_STORAGE_SERVICE=local

# Optional: Active Record Encryption (for MFA/2FA)
# Generate with: rails db:encryption:init
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
